<?xml version="1.0"?>
<package format="3">
  <name>allan_variance_ros2</name>
  <version>0.0.1</version>
  <description>
    Allan Variance ROS 2 package based on https://github.com/ori-drs/allan_variance_ros
  </description>

  <author email="russell@robots.ox.ac.uk">Russell Buchanan</author>
  <author email="christian-nils.boda@autoliv.com">Christian-Nils Åkerberg Boda</author>
  <maintainer email="christian-nils.boda@autoliv.com">Christian-Nils Åkerberg Boda</maintainer>

  <license>BSD-3-Clause</license>

  <url type="repository">https://github.com/christian-nils/allan_variance_ros2</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>boost</build_depend>
  <build_depend>boost-filesystem</build_depend>
  <build_depend>eigen3</build_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>yaml-cpp</depend>
  <depend>rosbag2_cpp</depend>
  <depend>rosbag2_storage_mcap</depend>

  <!-- Python runtime dependencies -->
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-scipy</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
